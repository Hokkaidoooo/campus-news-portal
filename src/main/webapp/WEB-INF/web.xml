<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd" version="3.1">
  <display-name>校园新闻门户</display-name>
  <context-param><param-name>javax.servlet.jsp.jstl.fmt.locale</param-name><param-value>zh_CN</param-value></context-param>
  <listener><listener-class>com.citywy.view.AppLifecycle</listener-class></listener>
  <filter>
    <filter-name>AccessControl</filter-name><filter-class>com.citywy.filter.AllFilter</filter-class>
    <init-param><param-name>user-management-role</param-name><param-value>管理员</param-value></init-param>
    <init-param><param-name>content-editor-role</param-name><param-value>用户</param-value></init-param>
  </filter>
  <filter-mapping><filter-name>AccessControl</filter-name><url-pattern>/*</url-pattern><dispatcher>REQUEST</dispatcher><dispatcher>FORWARD</dispatcher></filter-mapping>
  <servlet>
    <servlet-name>StaticContent</servlet-name>
    <servlet-class>org.apache.catalina.servlets.DefaultServlet</servlet-class>
    <init-param><param-name>fileEncoding</param-name><param-value>UTF-8</param-value></init-param>
  </servlet>
  <servlet-mapping><servlet-name>StaticContent</servlet-name><url-pattern>/</url-pattern></servlet-mapping>
  <servlet><servlet-name>LoginServlet</servlet-name><servlet-class>com.citywy.view.LoginServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>LoginServlet</servlet-name><url-pattern>/servlets/LoginServlet.htm</url-pattern></servlet-mapping>
  <servlet><servlet-name>IndexServlet</servlet-name><servlet-class>com.citywy.view.IndexServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>IndexServlet</servlet-name><url-pattern>/servlets/index.htm</url-pattern></servlet-mapping>
  <servlet><servlet-name>NewsServlet</servlet-name><servlet-class>com.citywy.view.NewsServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>NewsServlet</servlet-name><url-pattern>/servlets/news/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>UserServlet</servlet-name><servlet-class>com.citywy.view.UserServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>UserServlet</servlet-name><url-pattern>/servlets/user/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>NoticeServlet</servlet-name><servlet-class>com.citywy.view.NoticeServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>NoticeServlet</servlet-name><url-pattern>/servlets/notice/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>TopmenuServlet</servlet-name><servlet-class>com.citywy.view.TopmenuServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>TopmenuServlet</servlet-name><url-pattern>/servlets/topmenu/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>LeftmenuServlet</servlet-name><servlet-class>com.citywy.view.LeftmenuServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>LeftmenuServlet</servlet-name><url-pattern>/servlets/leftmenu/*</url-pattern></servlet-mapping>
  <servlet><servlet-name>CAjaxServlet</servlet-name><servlet-class>com.citywy.view.CAjaxServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>CAjaxServlet</servlet-name><url-pattern>/admin/ajax/*</url-pattern></servlet-mapping>
  <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
  <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
